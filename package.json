  },
  "homepage": "https://github.com/heychristoph/charityevals#readme",
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "astro": "^7.4.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
