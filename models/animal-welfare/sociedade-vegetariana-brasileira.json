  },
  "sections": [
    {
      "id": "p1_institutional_meat_reduction_ce",
      "title": "Program 1. Institutional meat reduction"
    },
    {
      "id": "bottom",
      "title": "Bottom line",
      "explainer": "SADs averted per dollar across the programs ACE modelled. Programs ACE didn't model are left out, not assumed to be zero or equal."
    },
    {
      "id": "donor",
      "title": "Your dollar's share",
      "explainer": "charityevals adjustments on top of ACE's model.",
      "kind": "ours"
    },
    {
      "id": "species",
      "title": "In chicken pain days",
      "explainer": "charityevals' standard step for every animal model, not ACE's. Ambitious Impact's suffering-adjusted days (SADs) count each species' pain as a share of a person's, using its own species weights. Here those weights come out and Rethink Priorities' estimates go in, so every species is counted in days of a chicken's disabling pain. How a chicken's suffering compares with a person's is the one animal slider, under Your values.",
      "kind": "ours"
    }
  ],
  "rows": [
    {
      "id": "p1_annual_meals_replaced_h5",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "Annual meals replaced H5",
      "value": 2474256,
      "kind": "estimate",
      "source": {
        "title": "ACE",
        "cell": "Annual meals replaced!H5"
      },
      "explainer": "From ACE's spreadsheet, cell Annual meals replaced!H5."
    },
    {
      "id": "p1_meals_replaced_across_all_institutions_in_2024",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "Meals replaced across all institutions in 2024",
      "formula": "p1_annual_meals_replaced_h5",
      "expected": 2474256
    },
    {
      "id": "p1_years_of_impact",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "Years of impact",
      "value": {
        "low": 3.0,
        "best": 5.477225575,
        "high": 10.0
      },
      "kind": "estimate",
      "source": {
        "title": "ACE",
        "cell": "Institutional Meat reduction CE!B7:D7"
      },
      "explainer": "ACE's best guess is the midpoint of its bounds; the range is ACE's."
    },
    {
      "id": "p1_annual_discount",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "Annual discount (1.4%)",
      "formula": "(1 - (1 / (1 + max($discount_rate, 0.000001))) ^ p1_years_of_impact) / ((1 - 1 / (1 + max($discount_rate, 0.000001))) * p1_years_of_impact)",
      "expected": 0.969582538
    },
    {
      "id": "p1_of_expenses_on_this_program_that_will_come_from",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "% of expenses on this program that will come from future years",
      "formula": "(6.25 * (p1_years_of_impact - 1)) / (100 + 6.25 * (p1_years_of_impact - 1))",
      "expected": 0.2186441497
    },
    {
      "id": "p1_meals_replaced_across_all_institutions_for_all_y",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "Meals replaced across all institutions for all years with annual discount",
      "formula": "p1_meals_replaced_across_all_institutions_in_2024 * p1_years_of_impact * p1_annual_discount * (1 - p1_of_expenses_on_this_program_that_will_come_from)",
      "expected": 10266890.09
    },
    {
      "id": "p1_animals_spared_per_meal_replaced",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "Animals spared per meal replaced",
      "formula": "@sad_factors.animals_spared_per_meal_replaced",
      "source": {
        "title": "ACE (Estimate (ACE))",
        "cell": "Institutional Meat reduction CE!B14"
      },
      "explainer": "Reads the shared figure, which is ACE's own number for this charity's meals."
    },
    {
      "id": "p1_sads_averted_per_meal_replaced",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "SADs averted per meal replaced",
      "formula": "@sad_factors.sads_per_meal_replaced",
      "published": 0.084,
      "source": {
        "title": "ACE (Estimate (ACE))",
        "cell": "Institutional Meat reduction CE!B15"
      },
      "explainer": "ACE's figure for one institutional meal replaced, in Ambitious Impact's suffering-adjusted days. ACE's 2024–25 reviews use 0.084 to 2.58 SADs for a replaced meal. Our view uses one shared figure (Suffering-adjusted days per animal, under Data) so replacing a meal counts the same in every model; the evaluator view keeps ACE's 0.084."
    },
    {
      "id": "p1_total_animals_spared_by_program_1",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "Total animals spared by program 1",
      "formula": "p1_meals_replaced_across_all_institutions_for_all_y * p1_animals_spared_per_meal_replaced",
      "expected": 1067756.57
    },
    {
      "id": "p1_total_sads_averted_by_program_1",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "Total SADs averted by program 1",
      "formula": "p1_meals_replaced_across_all_institutions_for_all_y * p1_sads_averted_per_meal_replaced",
      "expected": 862418.768
    },
    {
      "id": "p1_program_1_expenditures_total",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "Program 1 expenditures total (USD)",
      "formula": "110000 * (0.4 + 0.2)",
      "expected": 66000
    },
    {
      "id": "p1_program_1_expenditures_total_including_operation",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "Program 1 expenditures total including operational costs (USD)",
      "formula": "(582878 / 434812) * p1_program_1_expenditures_total",
      "expected": 88474.8995
    },
    {
      "id": "p1_meals_replaced",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "Meals replaced/$",
      "formula": "p1_meals_replaced_across_all_institutions_for_all_y / p1_program_1_expenditures_total_including_operation",
      "expected": 116.0429698
    },
    {
      "id": "p1_animals_spared",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "Animals spared/$",
      "formula": "p1_total_animals_spared_by_program_1 / p1_program_1_expenditures_total_including_operation",
      "expected": 12.06846886
    },
    {
      "id": "p1_sads_averted",
      "section": "p1_institutional_meat_reduction_ce",
      "label": "SADs averted/$",
      "formula": "p1_total_sads_averted_by_program_1 / p1_program_1_expenditures_total_including_operation",
      "expected": 9.747609467
    },
    {
      "id": "sads_total",
      "section": "bottom",
      "label": "SADs averted, all modelled programs",
      "format": "integer",
      "formula": "p1_sads_averted * p1_program_1_expenditures_total_including_operation"
    },
    {
      "id": "cost_total",
      "section": "bottom",
      "label": "Spending on the modelled programs",
      "format": "usd",
      "formula": "p1_program_1_expenditures_total_including_operation"
    },
    {
      "id": "sads_per_dollar",
      "section": "bottom",
      "label": "All modelled programs: SADs averted per dollar",
      "format": "number",
      "formula": "sads_total / cost_total"
    },
    {
      "id": "staff_cost_share",
      "section": "donor",
      "label": "Staff pay as a share of program cost",
      "format": "percent",
      "value": {
        "low": 0.5,
        "best": 0.65,
        "high": 0.8
      },
      "kind": "judgment",
      "explainer": "Advocacy is mostly people, so staff pay is usually most of the budget. We haven't seen this charity's breakdown; the default is the same guess we use for other animal advocacy groups. Range is ours."
    },
    {
      "id": "salary_gap",
      "section": "donor",
      "label": "Pay gap versus comparable for-profit jobs",
      "format": "percent",
      "value": {
        "low": 0.15,
        "best": 0.35,
        "high": 0.55
      },
      "kind": "judgment",
      "explainer": "Campaigners, researchers and negotiators could typically earn considerably more in comparable for-profit roles. Range is ours."
    },
    {
      "id": "salary_sacrifice",
      "section": "donor",
      "label": "Salary forgone by staff (in-kind donation)",
      "format": "usd",
      "formula": "cost_total * staff_cost_share * salary_gap / (1 - salary_gap)"
    },
    {
      "id": "donor_cost_share",
      "section": "donor",
      "label": "Share of the full cost paid by cash donations",
      "format": "percent",
      "formula": "cost_total / (cost_total + if($resource_shares, salary_sacrifice, 0))"
    },
    {
      "id": "sads_per_donor_dollar",
      "section": "donor",
      "label": "SADs averted per dollar you give",
      "format": "number",
      "formula": "sads_per_dollar * donor_cost_share"
    },
    {
      "id": "sads_fish",
      "section": "species",
      "label": "SADs averted per dollar you give: fish",
      "format": "number",
      "formula": "sads_per_donor_dollar * @sad_factors.meal_sads_share_fish",
      "explainer": "The SADs from replaced meals that fall on fish, by ACE's global estimate of which animals a replaced meal spares (Share of a replaced meal's suffering, under Data)."
    },
    {
      "id": "ced_fish",
      "section": "species",
      "label": "Chicken-equivalent pain days averted per dollar you give: fish",
      "format": "number",
      "formula": "sads_fish / @aim_sads.fish * if($rp_species_weights, @welfare_ranges.fish_vs_chicken, @aim_sads.fish / @aim_sads.chicken)",
      "explainer": "The SADs for fish with Ambitious Impact's weight for fish taken out, and Rethink Priorities' estimate of how much fish can suffer relative to a chicken put in. The evaluator view keeps Ambitious Impact's weights, so ACE's own result reproduces."
    },
    {
      "id": "sads_chicken",
      "section": "species",
      "label": "SADs averted per dollar you give: chickens",
      "format": "number",
      "formula": "sads_per_donor_dollar * @sad_factors.meal_sads_share_chicken",
      "explainer": "The SADs from replaced meals that fall on chickens, by ACE's global estimate of which animals a replaced meal spares (Share of a replaced meal's suffering, under Data)."
    },
    {
      "id": "ced_chicken",
      "section": "species",
      "label": "Chicken-equivalent pain days averted per dollar you give: chickens",
      "format": "number",
      "formula": "sads_chicken / @aim_sads.chicken * if($rp_species_weights, @welfare_ranges.chicken_vs_chicken, @aim_sads.chicken / @aim_sads.chicken)",
      "explainer": "The SADs for chickens with Ambitious Impact's weight for a hen (46% of a person's) taken out, which leaves days of a chicken's disabling pain. A chicken counts as 1 here by definition; how a chicken's suffering compares with a person's is the chicken slider. The evaluator view keeps Ambitious Impact's weight, so ACE's own result reproduces."
    },
    {
      "id": "sads_pig",
      "section": "species",
      "label": "SADs averted per dollar you give: pigs",
      "format": "number",
      "formula": "sads_per_donor_dollar * @sad_factors.meal_sads_share_pig",
      "explainer": "The SADs from replaced meals that fall on pigs, by ACE's global estimate of which animals a replaced meal spares (Share of a replaced meal's suffering, under Data)."
    },
    {
      "id": "ced_pig",
      "section": "species",
      "label": "Chicken-equivalent pain days averted per dollar you give: pigs",
      "format": "number",
      "formula": "sads_pig / @aim_sads.pig * if($rp_species_weights, @welfare_ranges.pig_vs_chicken, @aim_sads.pig / @aim_sads.chicken)",
      "explainer": "The SADs for pigs with Ambitious Impact's weight for pigs taken out, and Rethink Priorities' estimate of how much pigs can suffer relative to a chicken put in. The evaluator view keeps Ambitious Impact's weights, so ACE's own result reproduces."
    },
    {
      "id": "ced_per_donor_dollar",
      "section": "species",
      "label": "Chicken-equivalent pain days averted per dollar you give",
      "format": "number",
      "formula": "ced_fish + ced_chicken + ced_pig",
      "explainer": "Days of disabling pain spared, all species, counted as a chicken's. The headline converts this into years of healthy life with the chicken slider and the healthy hours lost per day of disabling pain."
    }
  ],
