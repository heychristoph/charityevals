      "id": "salary_gap",
      "section": "donor",
      "label": "Pay gap versus comparable for-profit jobs",
      "format": "percent",
      "value": {
        "low": 0.15,
        "best": 0.35,
        "high": 0.55
      },
      "kind": "judgment",
      "explainer": "Campaigners, researchers and negotiators could typically earn considerably more in comparable for-profit roles. Range is ours."
