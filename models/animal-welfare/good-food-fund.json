{
  "id": "good-food-fund",
  "name": "Good Food Fund",
  "kind": "charity",
  "cause": "animal-welfare",
  "charity": "good-food-fund",
  "owner": "ace",
  "summary": "Promotes plant-rich diets and food system change in China through a cooking network (Mama's Kitchen), an annual Good Food Summit and a youth leadership program. ACE did not estimate suffering averted for Good Food Fund because the inputs would be too speculative; this model uses the reach figures ACE reports and ranks them through the shared exchange rates for animals spared per person reached and SADs per animal spared.",
  "source": {
    "publisher": "Animal Charity Evaluators",
    "title": "Good Food Fund review",
    "url": "https://animalcharityevaluators.org/charity-review/good-food-fund/",
    "published": "2025-11-04",
    "retrieved": "2026-10-26",
    "license": "© Animal Charity Evaluators, all rights reserved (ACE's terms of use)"
  },
  "evaluator": {
    "name": "ACE",
    "assumptions": {
      "resource_shares": 0
    }
  },
  "sections": [
    {
      "id": "mk",
      "title": "Mama's Kitchen",
      "explainer": "A network of licensed partner organisations teaching plant-based home cooking."
    },
    {
      "id": "summit",
      "title": "Good Food Summit",
      "explainer": "An annual conference, streamed online."
    },
    {
      "id": "youth",
      "title": "Good Food Youth Leadership Program",
      "explainer": "A leadership program plus an online student competition."
    },
    {
      "id": "bottom",
      "title": "Bottom line",
      "explainer": "People reached per dollar across the three programs. Reach says nothing by itself about how many meals or animals are affected, which is why ACE didn't convert it into suffering averted. To rank it, the shared assumptions convert people reached into animals spared and then into SADs; those rates, not this model, carry that judgment."
    },
    {
      "id": "donor",
      "title": "Your dollar's share",
      "explainer": "charityevals adjustments on top of ACE's figures."
    }
  ],
  "rows": [
    {
      "id": "mk_people",
      "section": "mk",
      "label": "People reached by Mama's Kitchen (2023)",
      "format": "integer",
      "value": 100000,
      "kind": "observed",
      "source": {
        "title": "ACE, Good Food Fund review (2025)",
        "url": "https://animalcharityevaluators.org/charity-review/good-food-fund/",
        "note": "\"around 100,000 people through their licensed partner organizations in 2023\" (GFF's estimate)"
      },
      "explainer": "GFF's own estimate, reported by ACE."
    },
    {
      "id": "mk_per_dollar",
      "section": "mk",
      "label": "People reached per dollar (ACE)",
      "format": "number",
      "value": 0.3,
      "kind": "estimate",
      "source": {
        "title": "ACE, Good Food Fund review (2025)",
        "url": "https://animalcharityevaluators.org/charity-review/good-food-fund/",
        "note": "ACE's ratio, rounded"
      },
      "explainer": "ACE reports about 0.3 people reached per dollar spent."
    },
    {
      "id": "mk_cost",
      "section": "mk",
      "label": "Implied program spending",
      "format": "usd",
      "formula": "mk_people / mk_per_dollar"
    },
    {
      "id": "summit_people",
      "section": "summit",
      "label": "People reached by the Summit (2023)",
      "format": "integer",
      "value": 450400,
      "kind": "observed",
      "source": {
        "title": "ACE, Good Food Fund review (2025)",
        "url": "https://animalcharityevaluators.org/charity-review/good-food-fund/",
        "note": "\"around 450,000 people through online views on a streaming platform and 400 people in person\""
      },
      "explainer": "Online views plus in-person attendees. Online views overstate engaged viewers."
    },
    {
      "id": "summit_per_dollar",
      "section": "summit",
      "label": "People reached per dollar (ACE)",
      "format": "number",
      "value": 2.5,
      "kind": "estimate",
      "source": {
        "title": "ACE, Good Food Fund review (2025)",
        "url": "https://animalcharityevaluators.org/charity-review/good-food-fund/",
        "note": "ACE's ratio, rounded"
      },
      "explainer": "ACE reports about 2.5 people reached per dollar spent."
    },
    {
      "id": "summit_cost",
      "section": "summit",
      "label": "Implied program spending",
      "format": "usd",
      "formula": "summit_people / summit_per_dollar"
    },
    {
      "id": "youth_people",
      "section": "youth",
      "label": "People reached by the youth program (2023)",
      "format": "integer",
      "value": 90040,
      "kind": "observed",
      "source": {
        "title": "ACE, Good Food Fund review (2025)",
        "url": "https://animalcharityevaluators.org/charity-review/good-food-fund/",
        "note": "\"40 leader participants and 90,000 students participating in their online competition\""
      },
      "explainer": "40 leadership participants plus 90,000 students in the online competition."
    },
    {
      "id": "youth_per_dollar",
      "section": "youth",
      "label": "People reached per dollar (ACE)",
      "format": "number",
      "value": 0.5,
      "kind": "estimate",
      "source": {
        "title": "ACE, Good Food Fund review (2025)",
        "url": "https://animalcharityevaluators.org/charity-review/good-food-fund/",
        "note": "ACE's ratio, rounded"
      },
      "explainer": "ACE reports about 0.5 people reached per dollar counting everyone, or $3,000 per leadership participant."
    },
    {
      "id": "youth_cost",
      "section": "youth",
      "label": "Implied program spending",
      "format": "usd",
      "formula": "youth_people / youth_per_dollar"
    },
    {
      "id": "people_total",
      "section": "bottom",
      "label": "People reached, all programs",
      "format": "integer",
      "formula": "mk_people + summit_people + youth_people"
    },
    {
      "id": "cost_total",
      "section": "bottom",
      "label": "Implied spending, all programs",
      "format": "usd",
      "formula": "mk_cost + summit_cost + youth_cost",
      "explainer": "Back-calculated from ACE's rounded per-dollar ratios, so only approximate. ACE's review doesn't publish program budgets."
    },
    {
      "id": "people_per_dollar",
      "section": "bottom",
      "label": "People reached per dollar",
      "format": "number",
      "formula": "people_total / cost_total"
    },
    {
      "id": "staff_cost_share",
      "section": "donor",
      "label": "Staff pay as a share of program cost",
      "format": "percent",
      "value": {
        "low": 0.5,
        "best": 0.65,
        "high": 0.8
      },
      "kind": "judgment",
      "explainer": "Our default guess for advocacy and education groups; we haven't seen GFF's breakdown. Range is ours."
    },
    {
      "id": "salary_gap",
      "section": "donor",
      "label": "Pay gap versus comparable for-profit jobs",
      "format": "percent",
      "value": {
        "low": 0.15,
        "best": 0.35,
        "high": 0.55
      },
      "kind": "judgment",
      "explainer": "Our default guess for nonprofit advocacy staff. Range is ours."
    },
    {
      "id": "salary_sacrifice",
      "section": "donor",
      "label": "Salary forgone by staff (in-kind donation)",
      "format": "usd",
      "formula": "cost_total * staff_cost_share * salary_gap / (1 - salary_gap)"
    },
    {
      "id": "donor_cost_share",
      "section": "donor",
      "label": "Share of the full cost paid by cash donations",
      "format": "percent",
      "formula": "cost_total / (cost_total + if($resource_shares, salary_sacrifice, 0))"
    },
    {
      "id": "people_per_donor_dollar",
      "section": "donor",
      "label": "People reached per dollar you give",
      "format": "number",
      "formula": "people_per_dollar * donor_cost_share"
    },
    {
      "id": "animals_spared_per_person_reached",
      "section": "donor",
      "label": "Animals spared per person reached",
      "format": "number",
      "value": {
        "low": 0.01,
        "best": 0.18,
        "high": 1.5
      },
      "kind": "judgment",
      "source": {
        "title": "ACE's 2016 Guesstimate models (leaflets, pledges, social media)",
        "url": "https://www.getguesstimate.com/models/7338",
        "note": "@ace.ace2016_animals_spared_per_video_view, @ace.ace2016_animals_spared_per_leaflet, @ace.ace2016_animals_spared_per_pledge_participant"
      },
      "explainer": "How many farmed animals reaching one person spares, allowing for lapsing: about 84% of new vegetarians go back.\n\nACE's reference points: about 0.02 animals per video watched, 1 per leaflet, 6 per week-long vegan pledge. The default mixes these by Good Food Fund's reach: online views counted like videos, its cooking network like leaflets."
    },
    {
      "id": "animals_spared_per_donor_dollar",
      "section": "donor",
      "label": "Animals spared per dollar you give",
      "format": "small",
      "formula": "people_per_donor_dollar * animals_spared_per_person_reached"
    }
  ],
  "output": {
    "row": "animals_spared_per_donor_dollar",
    "unit": "animals_spared",
    "label": "Animals spared per dollar you give"
  },
