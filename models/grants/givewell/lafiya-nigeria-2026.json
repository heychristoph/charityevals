    {
      "id": "doses_of_dmpa_sc_lafiya_plans_to_distribute_in_2027",
      "label": "Doses of DMPA-SC Lafiya plans to distribute in 2027",
      "section": "main",
      "value": 2737280.0,
      "kind": "estimate",
      "source": {
        "title": "Source spreadsheet",
        "url": "https://docs.google.com/spreadsheets/d/1Ycz2094pKZu8jea406U8AxcCf1vN9Z4Lt_5UiNucb3w/edit",
        "cell": "Main!B4"
      },
      "explainer": "2m to 3m 10x - 16x input Lafiya, Lafiya Budget 2027 (unpublished)"
    },
    {
      "id": "years_of_protection_provided_per_dose",
      "label": "Years of protection provided per dose",
      "section": "main",
      "value": 0.25,
      "kind": "estimate",
      "source": {
        "title": "Source spreadsheet",
        "url": "https://docs.google.com/spreadsheets/d/1Ycz2094pKZu8jea406U8AxcCf1vN9Z4Lt_5UiNucb3w/edit",
        "cell": "Main!B5"
      },
      "explainer": "input \"Sayana Press, also known as DMPA-SC, is an easy-to-use injectable contraceptive for women. Sayana Press works by preventing ovulation, and provides contraceptive cover for at least 13 weeks.\" Lafiya, What is Sayana Press?"
    },
    {
      "id": "number_of_couple_years_protected_generated_by_program_before",
      "label": "Number of couple-years protected generated by program, before adjustments",
      "section": "main",
      "formula": "doses_of_dmpa_sc_lafiya_plans_to_distribute_in_2027 * years_of_protection_provided_per_dose",
      "expected": 684320.0
    },
    {
      "id": "adjustment_for_doses_not_actually_used",
      "label": "Adjustment for doses not actually used",
      "section": "main",
      "value": -0.1,
      "kind": "estimate",
      "source": {
        "title": "Source spreadsheet",
        "url": "https://docs.google.com/spreadsheets/d/1Ycz2094pKZu8jea406U8AxcCf1vN9Z4Lt_5UiNucb3w/edit",
        "cell": "Main!B10"
      },
      "explainer": "-20% to -5% 13x - 15x guess According to the 2025 annual report (see cell note), 38% of Lafiya clients chose self-injection (meaning they receive one dose during the visit, a get three to take home). For a cohort of 100 women, that would be 38x4 + 62x1 = 214 total doses, of which 114 are take-home. The Sokoto endline (see cell note) found that 61% of self-injectors used only 1 of 2 take-home doses (though this likely overstates true wastage since some women hadn't yet been due for their next dose), meaning half of their doses, or 30% of total doses, were wasted. Assuming that 30% of the 114 take-home doses are wasted gives 34 unused out of 214 total, or 16% of all doses. Adjusting downward for doses returned, shared, or saved for later use, a best guess of 10% seems reasonable.",
      "format": "percent"
    },
