    {
      "id": "deworming_value_at_shared_values",
      "label": "Deworming's long-term income gains at your discount rate and values, relative to GiveWell's",
      "section": "cameroon",
      "formula": "pv($discount_rate, @givewell_shared.long_term_benefit_years, -1) / (1 + $discount_rate) ^ @givewell_shared.years_until_income_benefits_deworming / (pv(@givewell_shared.income_discount_rate, @givewell_shared.long_term_benefit_years, -1) / (1 + @givewell_shared.income_discount_rate) ^ @givewell_shared.years_until_income_benefits_deworming) * $uov_per_ln_consumption * ln(2)",
      "published": 1,
      "format": "number",
      "explainer": "Changed for consistency. The sheet's multiples of cash come from GiveWell's deworming CEA, which values deworming by the income children earn later: 40 years of gains starting 8 years on, discounted at 4% and valued at 1/ln 2 units of value per unit of ln(consumption). Typed in as numbers, they ignored your discount rate and the income slider. This factor is the present value of those 40 years at your rate over the same at 4%, times the income slider over 1/ln 2, the same chain Deworm the World's model uses (it leaves out that CEA's decay of the effect over time, so it moves a little more than the full model would). It is 1 at the defaults; the evaluator view keeps the sheet's figures."
    },
    {
      "id": "total_cost_effectiveness",
      "label": "Total (Cost-effectiveness)",
      "section": "cameroon",
      "formula": "(sum(west_total_sac_treated_2023_2025 * west_cost_effectiveness, far_north_total_sac_treated_2023_2025 * far_north_cost_effectiveness, north_total_sac_treated_2023_2025 * north_cost_effectiveness, adamaoua_total_sac_treated_2023_2025 * adamaoua_cost_effectiveness, east_total_sac_treated_2023_2025 * east_cost_effectiveness, littoral_total_sac_treated_2023_2025 * littoral_cost_effectiveness, south_total_sac_treated_2023_2025 * south_cost_effectiveness) / sum(west_total_sac_treated_2023_2025, far_north_total_sac_treated_2023_2025, north_total_sac_treated_2023_2025, adamaoua_total_sac_treated_2023_2025, east_total_sac_treated_2023_2025, littoral_total_sac_treated_2023_2025, south_total_sac_treated_2023_2025)) * deworming_value_at_shared_values",
      "expected": 13.48746385
    },
    {
      "id": "cash_benchmark",
      "label": "Units of value per dollar given to GiveDirectly",
      "section": "bottom_line",
      "formula": "@cash.uov_per_dollar",
      "source": {
        "title": "GiveWell, cost-effectiveness benchmark",
        "url": "https://www.givewell.org/how-we-work/our-criteria/cost-effectiveness"
      },
      "explainer": "GiveWell reports this model's result in multiples of cash transfers. Multiplying by GiveWell's value of a dollar to GiveDirectly converts it into units of value per dollar, so it ranks against the other models. Older sheets used older moral weights; the multiple of cash is the comparable number across years. It is the site's shared cash benchmark (The cash benchmark, under Data), the one figure every model's multiple of cash is turned into units of value with."
    },
    {
      "id": "staff_cost_share",
      "section": "staff_pay",
      "label": "Staff pay as a share of program cost",
      "format": "percent",
      "explainer": "Default for programs that mostly buy and hand out goods (nets, drugs, supplements, vaccines, water treatment): staff pay is a small part of the cost. Our judgment; we haven't seen this program's breakdown.",
      "formula": "@staff_pay.share_goods"
    },
    {
      "id": "salary_gap",
      "section": "staff_pay",
      "label": "Pay gap versus comparable jobs elsewhere",
      "format": "percent",
      "explainer": "Delivery staff are mostly hired locally at local rates, so the gap is small. Our judgment.",
      "formula": "@staff_pay.gap_local_delivery"
    },
    {
      "id": "salary_sacrifice",
      "section": "staff_pay",
      "label": "Salary forgone by staff per dollar of cost (in-kind donation)",
      "format": "number",
      "formula": "staff_cost_share * salary_gap / (1 - salary_gap)"
    },
    {
      "id": "donor_cost_share",
      "section": "staff_pay",
      "label": "Share of the full cost paid in cash",
      "format": "percent",
      "formula": "1 / (1 + if($resource_shares, salary_sacrifice, 0))",
      "explainer": "With credit by share of resources, staff's forgone pay counts as part of the cost, and staff get their share of the outcome. Off, this is 100%."
    },
    {
      "id": "uov_per_dollar",
      "label": "Units of value per dollar",
      "section": "bottom_line",
      "formula": "(total_cost_effectiveness * cash_benchmark) * donor_cost_share",
      "explainer": "With credit by share of resources, times the share of the full cost paid in cash (staff's forgone pay is the rest)."
    }
  ],
