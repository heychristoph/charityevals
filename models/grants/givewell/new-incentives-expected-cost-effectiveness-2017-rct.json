      "source": {
        "title": "GiveWell, cost-effectiveness benchmark",
        "url": "https://www.givewell.org/how-we-work/our-criteria/cost-effectiveness"
      },
      "explainer": "GiveWell reports this model's result in multiples of cash transfers. Multiplying by GiveWell's value of a dollar to GiveDirectly converts it into units of value per dollar, so it ranks against the other models. Older sheets used older moral weights; the multiple of cash is the comparable number across years."
    },
    {
      "id": "staff_cost_share",
      "section": "staff_pay",
      "label": "Staff pay as a share of program cost",
      "format": "percent",
      "value": 0.19,
      "kind": "observed",
      "source": {
        "title": "GiveWell, New Incentives review (spending breakdown, November 2017 to December 2023)",
        "url": "https://www.givewell.org/charities/new-incentives"
      },
      "explainer": "Staff compensation was 19% of New Incentives' spending from November 2017 to December 2023 ($8.90m of $46.21m), per GiveWell's review."
    },
    {
      "id": "salary_gap",
      "section": "staff_pay",
      "label": "Pay gap versus comparable jobs elsewhere",
      "format": "percent",
      "value": {
        "low": 0,
        "best": 0.1,
        "high": 0.25
      },
      "kind": "judgment",
      "explainer": "Delivery staff are mostly hired locally at local rates, so the gap is small. Our judgment."
    },
    {
      "id": "salary_sacrifice",
      "section": "staff_pay",
      "label": "Salary forgone by staff per dollar of cost (in-kind donation)",
      "format": "number",
      "formula": "staff_cost_share * salary_gap / (1 - salary_gap)"
    },
    {
      "id": "donor_cost_share",
      "section": "staff_pay",
      "label": "Share of the full cost paid in cash",
      "format": "percent",
      "formula": "1 / (1 + if($resource_shares, salary_sacrifice, 0))",
      "explainer": "With credit by share of resources, staff's forgone pay counts as part of the cost, and staff get their share of the outcome. Off, this is 100%."
    },
    {
      "id": "uov_per_dollar",
      "label": "Units of value per dollar",
      "section": "bottom_line",
      "formula": "(expected_cost_effectiveness_expressed_as_multiplier_of_gived * cash_benchmark) * donor_cost_share",
      "explainer": "With credit by share of resources, times the share of the full cost paid in cash (staff's forgone pay is the rest)."
    }
