   "label": "Percentage increase in wages/consumption for every 1 point increase in IQ",
   "section": "main",
   "value": 0.01,
   "kind": "estimate",
   "source": {
    "title": "Source spreadsheet",
    "url": "https://docs.google.com/spreadsheets/d/1TRY43-L1hipvYduQX9lyNJiEU0LqQaevEDRf3pvOgUE/edit",
    "cell": "Main!B32"
   },
   "explainer": "Same methodology as in the GiveWell's iodine CE estimate, using information from DCP2, 'Economic Benefits of Long-Term Improvements in IQ' section here: https://www.ncbi.nlm.nih.gov/books/NBK11783/",
   "format": "percent"
