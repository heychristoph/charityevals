    {
      "id": "speculative_adjustment_to_assess_the_long_term_benefit_of_ma",
      "label": "Speculative adjustment to assess the long-term benefit of many years of iron",
      "section": "main",
      "value": 0.1,
      "kind": "estimate",
      "source": {
        "title": "Source spreadsheet",
        "url": "https://docs.google.com/spreadsheets/d/1TRY43-L1hipvYduQX9lyNJiEU0LqQaevEDRf3pvOgUE/edit",
        "cell": "Main!B33"
      },
      "explainer": "We see increases in IQ after supplementation for less than 1 year. It could be that there's a linear effect (e.g. one year of supplementation raises IQ by 5 points, 2 years raises IQ by 10 points). That's extremely implausible though. More likely, going from low haemoglobin levels to normal haemoglobin levels leads to an IQ increase of a couple points. I would guess that those cognitive benefits remain as long as someone is non-anemic and mostly disappear if haemoglobin levels return to the initial low levels. I have much more to say about this. More details here: https://docs.google.com/document/d/15ifHdYl-mI6ZF_SgksADD3myusxya3ZBYrPHLKt9_ao/edit?usp=sharing",
      "format": "percent"
    },
    {
      "id": "percentage_increase_in_wages_consumption_from_increase_in_iq",
      "label": "Percentage increase in wages/consumption from increase in IQ from supplementation",
      "section": "main",
      "formula": "change_in_intelligence_quotient_from_short_term_supplementat * 15 * percentage_increase_in_wages_consumption_for_every_1_point_i * speculative_adjustment_to_assess_the_long_term_benefit_of_ma",
      "expected": 0.00495,
      "format": "percent"
    },
    {
      "id": "increase_in_annual_ln_consumption_for_beneficiaries",
      "label": "Increase in annual ln(consumption) for beneficiaries",
      "section": "main",
      "formula": "ln(1 + percentage_increase_in_wages_consumption_from_increase_in_iq) - ln(1)",
      "expected": 0.00493778903
    },
