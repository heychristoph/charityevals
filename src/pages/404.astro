---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" noindex>
  <div class="page wrap">
    <h1>Page not found</h1>
    <p class="dek">There's no page at this address. Charity pages live at <code>/&lt;charity&gt;</code>, for example <a href="/givedirectly">/givedirectly</a>.</p>
    <p><a href="/">See all charities</a></p>
  </div>
</Base>

<style>
  .wrap {
    max-width: 720px;
    padding-top: var(--s7);
    display: grid;
    gap: var(--s4);
  }
  .dek {
    font-size: 19px;
    color: var(--ink-2);
  }
</style>
