---
import Base from "../layouts/Base.astro";
import ModelView from "../components/ModelView.tsx";
import AssumptionsPanel from "../components/AssumptionsPanel.tsx";
import VariantList from "../components/VariantList.tsx";
import { lib, rankable } from "../lib/data";

export function getStaticPaths() {
  return rankable.map((m) => ({ params: { id: m.id } }));
}

const model = lib.models.get(Astro.params.id!)!;
const writeups = import.meta.glob<{ Content: any }>("../../writeups/*.md", { eager: true });
// Variants share their parent's write-up unless they have their own.
const writeupId = [model.id, ...model.chain.slice(1)].find((id) => writeups[`../../writeups/${id}.md`]);
const Writeup = writeupId ? writeups[`../../writeups/${writeupId}.md`].Content : undefined;
const parent = model.extends ? lib.models.get(model.extends) : undefined;
const root = parent && model.kind === "variant" ? parent : model;
const family = [root, ...rankable.filter((m) => m.extends === root.id && m.kind === "variant")];
const RES_GROUPS = [
  ["evaluation", "Evaluations"],
  ["model", "Models and spreadsheets"],
  ["study", "Studies and research"],
  ["data", "Data and documents"],
  ["charity", "From the charity"],
  ["other", "Other sources"],
] as const;
const resources = RES_GROUPS.map(([type, title]) => ({ type, title, items: (model.resources ?? []).filter((r) => r.type === type) })).filter((g) => g.items.length);
const CAUSE = { "global-health": "Global health", "animal-welfare": "Animal welfare", "ai-safety": "AI safety" } as const;
const fmtDate = (d?: string) => (d ? new Date(d).toLocaleDateString("en-GB", { year: "numeric", month: "long" }) : undefined);
---

<Base title={model.name} description={model.summary} active="rankings">
  <div class="page layout" style={`--cause: var(--cause-${model.cause})`}>
    <div class="main">
      <nav class="crumbs small" aria-label="Breadcrumb"><a href="/">Rankings</a> / {CAUSE[model.cause]}</nav>
      <header class="m-header">
        <h1>{model.name}</h1>
        {model.summary && <p class="dek">{model.summary}</p>}
        {model.org?.donate && (
          <div class="donate">
            <a class="donate-button" href={model.org.donate} rel="noopener">Donate to {model.org.name}{model.org.donate_via && ` via ${model.org.donate_via}`}<span aria-hidden="true"> ↗</span></a>
            <span class="small muted">
              {model.org.donate_via
                ? `Goes to ${model.org.donate_via}'s donation form, where you can direct your gift to ${model.org.name}.`
                : `Goes to ${model.org.name}'s own donation page.`} charityevals takes nothing and isn't paid for listings.
            </span>
          </div>
        )}
        <dl class="m-meta small">
          {model.org?.website && (
            <div><dt>Organisation</dt><dd><a href={model.org.website}>{model.org.name}</a></dd></div>
          )}
          {model.source && (
            <div>
              <dt>Based on</dt>
              <dd>
                <a href={model.source.url}>{model.source.publisher}, {model.source.title}</a>
                {model.source.sheet && <> (<a href={model.source.sheet}>spreadsheet</a>)</>}
              </dd>
            </div>
          )}
          {model.source?.published && <div><dt>Published</dt><dd>{fmtDate(model.source.published)}, retrieved {fmtDate(model.source.retrieved)}</dd></div>}
          {model.source?.license && <div><dt>Licence</dt><dd>{model.source.license}</dd></div>}
          {parent && <div><dt>Extends</dt><dd><a href={`/${parent.id}`}>{parent.name}</a>: inherits every row and overrides a few</dd></div>}

          <div>
            <dt>Model file</dt>
            <dd><a href={`https://github.com/heychristoph/charityevals/blob/main/models/${model.cause}/${model.id}.json`}>{model.id}.json</a> · <a href={`/${model.id}/history`}>change history</a></dd>
          </div>
        </dl>
      </header>
      {family.length > 1 && (
        <details class="family" open={family.length <= 8}>
          <summary>{family.length} countries and programs in {root.source?.publisher ?? "the"} model</summary>
          <p class="small muted">Same model, each with its own inputs. Multiples of GiveDirectly, under your assumptions.</p>
          <VariantList client:load ids={family.map((m) => m.id)} current={model.id} />
        </details>
      )}
      <ModelView client:load id={model.id}>
        {Writeup && (
          <section class="writeup" aria-labelledby="writeup-title">
            <h2 id="writeup-title" class="writeup-title">The evaluation</h2>
            <Writeup />
          </section>
        )}
      </ModelView>
      {resources.length > 0 && (
        <section class="resources" aria-labelledby="resources-title">
          <h2 id="resources-title">Evidence and sources</h2>
          <p class="muted small">Everything the evaluation links to, so you can check it yourself. Collected from {model.source?.publisher ?? "the evaluator"}'s review.</p>
          {resources.map((g) => (
            <div class="res-group">
              <h3>{g.title} <span class="muted small num">{g.items.length}</span></h3>
              <ul>
                {g.items.slice(0, 8).map((r) => <li><a href={r.url} rel="noopener">{r.title}</a>{r.note && <span class="muted small"> · {r.note}</span>}</li>)}
              </ul>
              {g.items.length > 8 && (
                <details>
                  <summary class="small">Show {g.items.length - 8} more</summary>
                  <ul>{g.items.slice(8).map((r) => <li><a href={r.url} rel="noopener">{r.title}</a></li>)}</ul>
                </details>
              )}
            </div>
          ))}
        </section>
      )}
    </div>
    <aside class="side" aria-label="Assumptions">
      <AssumptionsPanel client:load />
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: var(--s7);
    align-items: start;
    padding-top: var(--s5);
  }
  .writeup {
    max-width: var(--measure);
    padding: var(--s5) 0 var(--s2);
    border-top: 1px solid var(--rule);
  }
  .writeup-title {
    font-size: 26px;
    margin-bottom: var(--s3);
  }
  .writeup :global(h2) {
    font-size: 20px;
    margin: var(--s5) 0 var(--s2);
  }
  .writeup :global(p),
  .writeup :global(ul),
  .writeup :global(ol) {
    margin: 0 0 var(--s3);
  }
  .writeup :global(ul),
  .writeup :global(ol) {
    padding-left: 1.3em;
  }
  .writeup :global(li + li) {
    margin-top: var(--s1);
  }
  .crumbs {
    color: var(--ink-2);
    margin-bottom: var(--s3);
  }
  .m-header {
    display: grid;
    gap: var(--s3);
    margin-bottom: var(--s6);
  }
  .dek {
    font-size: 18px;
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .resources {
    margin-top: var(--s7);
    padding-top: var(--s5);
    border-top: 1px solid var(--rule);
    display: grid;
    gap: var(--s4);
  }
  .res-group h3 {
    font-size: 17px;
    margin-bottom: var(--s2);
  }
  .res-group ul {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 3px;
    font-size: 15px;
  }
  .res-group a {
    overflow-wrap: anywhere;
  }
  .res-group details summary {
    cursor: pointer;
    color: var(--blue);
    margin: var(--s2) 0;
  }
  .family {
    margin: calc(var(--s3) * -1) 0 var(--s6);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--s3) var(--s4);
  }
  .family summary {
    cursor: pointer;
    font-weight: 600;
  }
  .family :global(.variant-list) {
    list-style: none;
    padding: 0;
    margin: var(--s2) 0 0;
    columns: 2 260px;
    column-gap: var(--s6);
  }
  .family :global(.variant-list li) {
    display: flex;
    justify-content: space-between;
    gap: var(--s3);
    padding: 3px 0;
    border-bottom: 1px solid var(--rule);
    break-inside: avoid;
  }
  .family :global(.variant-list li.current a) {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .donate {
    display: flex;
    gap: var(--s2) var(--s4);
    align-items: center;
    flex-wrap: wrap;
  }
  .donate-button {
    display: inline-block;
    background: var(--blue);
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
    padding: 9px 18px;
    border-radius: var(--radius);
  }
  .donate-button:hover {
    background: var(--blue-ink);
    color: var(--paper);
  }
  .m-meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--s1) var(--s4);
    margin: var(--s2) 0 0;
  }
  .m-meta div {
    display: contents;
  }
  .m-meta dt {
    color: var(--ink-2);
  }
  .m-meta dd {
    margin: 0;
  }
  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .m-meta {
      grid-template-columns: 1fr;
    }
    .m-meta dd {
      margin-bottom: var(--s2);
    }
  }
</style>
