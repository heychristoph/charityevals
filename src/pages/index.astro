---
import Base from "../layouts/Base.astro";
import Rankings from "../components/Rankings.tsx";
import AssumptionsPanel from "../components/AssumptionsPanel.tsx";
import Onboarding from "../components/Onboarding.tsx";

---

<Base title="charityevals: open charity cost-effectiveness analyses" active="rankings">
  <div class="page layout">
    <div class="main">
      <header class="intro">
        <h1>Which charities do the most good per dollar, on your assumptions?</h1>
        <p class="dek">
          Every cause on one scale, built by AI from public sources. Change the values and the ranking moves.
        </p>
      </header>
      <Rankings client:load />
      <p class="count small muted"><a href="/suggest">Suggest a charity</a></p>
    </div>
    <aside class="side" aria-label="Assumptions">
      <AssumptionsPanel client:load />
    </aside>
  </div>
  <Onboarding client:load />
  <script>
    // The walk-through's first screen opens as soon as the page is parsed, before the island loads.
    import { openOnboarding } from "../lib/onboarding";
    openOnboarding();
  </script>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: var(--s7);
    align-items: start;
    padding-top: var(--s6);
  }
  .intro {
    display: grid;
    gap: var(--s3);
    margin-bottom: var(--s6);
  }
  .dek {
    font-size: 19px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 62ch;
  }
  .count {
    margin-top: var(--s5);
  }
  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--s6);
    }
  }
</style>
