---
import Base from "../layouts/Base.astro";
import Rankings from "../components/Rankings.tsx";
import AssumptionsPanel from "../components/AssumptionsPanel.tsx";
import Onboarding from "../components/Onboarding.tsx";
import { rankedCharities, rankable, theoreticalOnly } from "../lib/data";

---

<Base title="charityevals: open charity cost-effectiveness analyses" active="rankings">
  <div class="page layout">
    <div class="main">
      <header class="intro">
        <h1>Which charities do the most good per dollar, on your assumptions?</h1>
        <p class="dek">
          Charity evaluators' analyses and, where there are none, our own: built by AI, with their sources. Change the assumptions and the ranking moves.
        </p>
      </header>
      <Rankings client:load />
      <p class="count small muted">{rankedCharities.length - theoreticalOnly.length} charities, {rankable.length} models. <a href="/suggest">Suggest a charity</a></p>
      {theoreticalOnly.length > 0 && (
        <p class="small muted">Not ranked, <a href="/method#theoretical">purely theoretical</a>: {theoreticalOnly.map((c, i) => <>{i > 0 && ", "}<a href={`/${c.id}`}>{c.name}</a></>)}.</p>
      )}
    </div>
    <aside class="side" aria-label="Assumptions">
      <AssumptionsPanel client:load />
    </aside>
  </div>
  <Onboarding client:load />
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: var(--s7);
    align-items: start;
    padding-top: var(--s6);
  }
  .intro {
    display: grid;
    gap: var(--s3);
    margin-bottom: var(--s6);
  }
  .dek {
    font-size: 19px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 62ch;
  }
  .count {
    margin-top: var(--s5);
  }
  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--s6);
    }
  }
</style>
