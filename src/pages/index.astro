---
import Base from "../layouts/Base.astro";
import Rankings from "../components/Rankings.tsx";
import AssumptionsPanel from "../components/AssumptionsPanel.tsx";
import { lib, unranked, ranked, rankable } from "../lib/data";

---

<Base title="charityevals" active="rankings">
  <div class="page layout">
    <div class="main">
      <header class="intro">
        <h1>Which charities do the most good per dollar, on your assumptions?</h1>
        <p class="dek">
          Published cost-effectiveness analyses, rebuilt so every number has a source, a range and an explanation, and re-ranked live by the assumptions you set.
        </p>
      </header>
      <Rankings client:load />
      {unranked.length > 0 && (
        <section class="unranked" aria-labelledby="unranked-title">
          <h2 id="unranked-title">Evaluated, not ranked</h2>
          <p class="muted small">Their evaluators report results in units nobody can convert into good done elsewhere, so they have pages but no place on the list.</p>
          <ul>
            {unranked.map((m) => (
              <li><a href={`/${m.id}`}>{m.name}</a> <span class="muted small">· {lib.assumptions.units[m.output!.unit].label} per dollar · {m.source?.publisher}</span></li>
            ))}
          </ul>
        </section>
      )}
      <p class="count small muted">{ranked.length} charities ranked, {rankable.length - ranked.length - unranked.length} more country and program variants on their charities' pages.</p>
    </div>
    <aside class="side" aria-label="Assumptions">
      <AssumptionsPanel client:load />
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: var(--s7);
    align-items: start;
    padding-top: var(--s6);
  }
  .intro {
    display: grid;
    gap: var(--s3);
    margin-bottom: var(--s6);
  }
  .dek {
    font-size: 19px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 62ch;
  }
  .unranked {
    margin-top: var(--s6);
  }
  .unranked h2 {
    font-size: 20px;
    margin-bottom: var(--s2);
  }
  .unranked ul {
    margin: var(--s2) 0 0;
    padding-left: 1.1em;
  }
  .count {
    margin-top: var(--s5);
  }
  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--s6);
    }
  }
</style>
