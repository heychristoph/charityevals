---
// Long-form text pages: method, about, privacy, terms, legal notice.
import Base from "./Base.astro";

interface Props {
  title: string;
  description?: string;
  updated?: string;
  active?: "about" | "method" | "ai";
  /** The page's sections, for a side menu that follows the reader (a strip along the top on narrow screens). */
  toc?: { id: string; label: string }[];
}
const { title, description, updated, active, toc } = Astro.props;
---

<Base title={title} description={description} active={active}>
  {/* The page's width and edges like every other page; the text in a readable column on its left. */}
  <div class:list={["page", { "with-toc": toc?.length }]}>
    {toc?.length ? (
      <nav class="toc" aria-label="On this page" data-toc>
        <ol>
          {toc.map((t) => (
            <li><a href={`#${t.id}`}>{t.label}</a></li>
          ))}
        </ol>
      </nav>
    ) : null}
    <article class="prose wrap" data-gloss>
      <slot name="before-title" />
      <h1>{title}</h1>
      {updated && <p class="updated small muted">Last updated {updated}</p>}
      <slot />
    </article>
  </div>
</Base>

<script>
  // Marks the section being read: the last one whose heading has passed a third of the way down the
  // window, or the last one at the bottom of the page.
  const nav = document.querySelector<HTMLElement>("[data-toc]");
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>("a")];
    const heads = links.map((a) => document.getElementById(a.hash.slice(1))).filter((h): h is HTMLElement => h !== null);
    const list = nav.querySelector("ol")!;
    let current = "";
    const pick = () => {
      const line = window.innerHeight * 0.34;
      const atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      let id = "";
      for (const h of heads) if (h.getBoundingClientRect().top <= line) id = h.id;
      if (atEnd && heads.length) id = heads[heads.length - 1].id;
      if (id === current) return;
      current = id;
      for (const a of links) {
        if (a.hash === `#${id}`) {
          a.setAttribute("aria-current", "location");
          // On a narrow screen the menu is a strip: keep the current section in it visible.
          if (list.scrollWidth > list.clientWidth) list.scrollTo({ left: a.offsetLeft - list.offsetLeft - 16, behavior: "smooth" });
        } else a.removeAttribute("aria-current");
      }
    };
    let frame = 0;
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(() => ((frame = 0), pick()));
    };
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    pick();
  }
</script>

<style>
  .wrap {
    max-width: 760px;
    padding-top: var(--s6);
  }
  h1 {
    margin-bottom: var(--s2);
  }
  .updated {
    margin-bottom: var(--s5);
  }
  .wrap :global(h2) {
    font-size: 22px;
    margin: var(--s6) 0 var(--s3);
  }
  .wrap :global(p + p),
  .wrap :global(ul + p),
  .wrap :global(p + ul) {
    margin-top: var(--s3);
  }
  .wrap :global(ul) {
    padding-left: 1.3em;
    margin: 0;
  }
  .wrap :global(li + li) {
    margin-top: var(--s1);
  }
  .wrap :global(address) {
    font-style: normal;
  }

  /* The side menu: beside the text on wide screens. */
  .with-toc {
    display: grid;
    grid-template-columns: minmax(0, 760px) 220px;
    column-gap: var(--s7);
    align-items: start;
  }
  .with-toc .wrap {
    grid-column: 1;
    grid-row: 1;
  }
  .with-toc .wrap :global([id]) {
    scroll-margin-top: var(--s5);
  }
  .toc {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: calc(var(--header-h, 0px) + var(--s5));
    max-height: calc(100vh - var(--header-h, 0px) - 2 * var(--s5));
    overflow-y: auto;
    margin-top: calc(var(--s6) + 64px);
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--rule);
  }
  .toc li {
    margin: 0;
  }
  .toc a {
    display: block;
    margin-left: -1px;
    padding: 5px 0 5px var(--s3);
    border-left: 2px solid transparent;
    font: 15px/1.3 var(--sans);
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.2s ease-out, border-color 0.2s ease-out;
  }
  .toc a:hover {
    color: var(--ink);
  }
  .toc a[aria-current] {
    color: var(--ink);
    border-left-color: var(--blue);
  }

  /* A strip along the top on narrower screens. */
  @media (max-width: 1100px) {
    .with-toc {
      display: block;
    }
    .with-toc .wrap :global([id]) {
      scroll-margin-top: 56px;
    }
    .toc {
      top: var(--header-h, 0px);
      z-index: 5;
      max-height: none;
      overflow: visible;
      margin: 0 calc(-1 * var(--s5));
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
    }
    .toc ol {
      display: flex;
      gap: var(--s5);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      padding: var(--s2) var(--s5);
      border-left: 0;
    }
    .toc ol::-webkit-scrollbar {
      display: none;
    }
    .toc li {
      flex-shrink: 0;
    }
    .toc a {
      margin: 0;
      padding: 4px 0;
      border-left: 0;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
    }
    .toc a[aria-current] {
      border-bottom-color: var(--blue);
    }
  }
  @media (max-width: 640px) {
    .toc {
      margin: 0 calc(-1 * var(--s4));
    }
    .toc ol {
      padding: var(--s2) var(--s4);
    }
  }
</style>
