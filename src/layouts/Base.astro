---
import "../styles/global.css";
import Consent from "../components/Consent.astro";

interface Props {
  title: string;
  description?: string;
  active?: "rankings" | "assumptions" | "method" | "about";
}
const { title, description = "Open cost-effectiveness analyses for charities. Every number has a source, a range and an explanation, and your own assumptions re-rank everything.", active } = Astro.props;
const fullTitle = title === "charityevals" ? title : `${title} · charityevals`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const nav = [
  { id: "rankings", href: "/", label: "Rankings" },
  { id: "assumptions", href: "/assumptions", label: "Assumptions" },
  { id: "method", href: "/method", label: "Method" },
  { id: "about", href: "/about", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="charityevals" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2f5fb3" />
  </head>
  <body>
    <header class="site-header">
      <div class="page bar">
        <a class="wordmark" href="/" aria-label="charityevals, home"><img src="/logo.svg" alt="charityevals" width="190" height="32" /></a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={active === n.id ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="page foot">
        <nav class="foot-links" aria-label="Site">
          <a href="/suggest">Suggest a charity</a>
          <a href="/about">About</a>
          <a href="/method">Method</a>
          <a href="/privacy">Privacy</a>
          <button type="button" data-consent-open>Privacy settings</button>
          <a href="/terms">Terms</a>
          <a href="/legal">Legal notice</a>
          <a href="https://github.com/heychristoph/charityevals">GitHub</a>
          <a href="mailto:hello@charityevals.org">hello@charityevals.org</a>
        </nav>
        <p>
          Models are re-implementations of published analyses, credited on each page. GiveWell and ACE have not reviewed or endorsed this site. Estimates are for research, not financial advice.
        </p>
      </div>
    </footer>
    <Consent />
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s5);
    padding-top: var(--s4);
    padding-bottom: var(--s4);
    flex-wrap: wrap;
  }
  .wordmark {
    display: block;
    line-height: 0;
    align-self: center;
  }
  .wordmark img {
    height: 32px;
    width: auto;
  }
  nav {
    display: flex;
    gap: var(--s5);
    font-size: 15px;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--blue);
  }
  .site-footer {
    margin-top: var(--s8);
    border-top: 1px solid var(--rule);
    background: var(--paper-2);
  }
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s5);
    font-size: 14px;
  }
  .foot-links a {
    color: var(--ink-2);
  }
  .foot {
    padding-top: var(--s5);
    padding-bottom: var(--s6);
    display: grid;
    gap: var(--s2);
    font-size: 14px;
    color: var(--ink-2);
    max-width: var(--page);
  }
  @media (max-width: 640px) {
    nav {
      gap: var(--s4);
    }
  }
</style>
