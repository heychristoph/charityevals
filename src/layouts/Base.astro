---
import "../styles/global.css";
import serifFont from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import sansFont from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";
import { canonicalPath, documentTitle, jsonLd, siteSchema } from "../lib/seo";
import Consent from "../components/Consent.astro";

interface Props {
  title: string;
  description?: string;
  active?: "rankings" | "method" | "ai" | "about";
  /** Keep the page out of search results (its links are still followed). */
  noindex?: boolean;
  /** schema.org nodes for this page, added to the site's own (WebSite, Organization). */
  schema?: object[];
}
const { title, description = "Open cost-effectiveness analyses for charities. Every number has a source, a range and an explanation, and your own assumptions re-rank everything.", active, noindex = false, schema = [] } = Astro.props;
const fullTitle = documentTitle(title);
const metaDescription = description.replace(/\s+/g, " ").trim();
const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const structured = jsonLd([...siteSchema(), ...schema]);
const nav = [
  { id: "rankings", href: "/", label: "Rankings" },
  { id: "method", href: "/method", label: "Method" },
  { id: "ai", href: "/ai", label: "For AIs" },
  { id: "about", href: "/about", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="charityevals" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="charityevals: adjustable charity cost-effectiveness models, by AI." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <script type="application/ld+json" set:html={structured} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2f5fb3" />
    <noscript><style>.wf-skeleton { display: none; }</style></noscript>
    {/* The page is built at the default values. A reader with values of their own (stored, or in the link:
        src/lib/assumption-state.ts) would see the defaults flash until the islands run, so until each
        island has hydrated it holds its place unseen; after 4 s whatever is there shows. */}
    <style is:inline>html.own-values astro-island[ssr] { visibility: hidden; }</style>
    <script is:inline>
      try {
        var q = location.search, s = localStorage.getItem("charityevals:assumptions");
        if (/[?&](values|set|a\.[a-z_]+)=/.test(q) || (s && s !== "{}")) {
          document.documentElement.classList.add("own-values");
          setTimeout(function () { document.documentElement.classList.remove("own-values"); }, 4000);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="beta-ribbon">
      <a href="https://tally.so/r/VpQALj" target="_blank" rel="noopener">Beta · Feedback</a>
    </div>
    <header class="site-header">
      <div class="page bar">
        <a class="wordmark" href="/" aria-label="charityevals, home"><img src="/logo.svg" alt="charityevals" width="188" height="32" /></a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={active === n.id ? "page" : undefined}>{n.label}</a>
          ))}
          <a class="nav-cta" href="https://charityevals.substack.com/" rel="noopener">Subscribe</a>
        </nav>
      </div>
    </header>
    <script is:inline>
      // Where the links wrap under the wordmark (a phone), only their row stays: the header sticks with
      // the wordmark's row above the screen. --header-h is what stays, for what sticks below it and for
      // links to a heading (global.css).
      (() => {
        const h = document.querySelector(".site-header");
        const nav = h.querySelector("nav"), mark = h.querySelector(".wordmark");
        const set = () => {
          const hide = nav.offsetTop > mark.offsetTop + mark.offsetHeight / 2 ? Math.max(0, nav.offsetTop - 8) : 0;
          h.style.top = `${-hide}px`;
          document.documentElement.style.setProperty("--header-h", `${h.offsetHeight - hide}px`);
        };
        set();
        if (typeof ResizeObserver !== "undefined") new ResizeObserver(set).observe(h);
      })();
    </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="page foot">
        <nav class="foot-links" aria-label="Site">
          <a href="https://charityevals.substack.com/" rel="noopener">Subscribe</a>
          <a href="/suggest">Suggest a charity</a>
          <a href="/about">About</a>
          <a href="/method">Method</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/about#legal-notice">Legal notice</a>
          <a href="https://github.com/heychristoph/charityevals">GitHub</a>
          <a href="mailto:hello@charityevals.org">hello@charityevals.org</a>
        </nav>
        <p class="foot-note">Written and checked by AI agents, so estimates can be wrong. Not advice: see the <a href="/terms">terms</a>.</p>
      </div>
    </footer>
    <script>
      import "../scripts/glossary-tips";
      import "../scripts/external-links";
    </script>
    <Consent ask={canonicalPath(Astro.url.pathname) !== "/privacy"} />
  </body>
</html>

<style>
  /* The beta ribbon across the top-right corner of every page: the link opens the feedback form. */
  .beta-ribbon {
    position: absolute;
    top: 0;
    right: 0;
    width: 120px;
    height: 120px;
    overflow: hidden;
    z-index: 30;
    pointer-events: none;
  }
  .beta-ribbon a {
    position: absolute;
    top: 26px;
    right: -42px;
    width: 170px;
    transform: rotate(45deg);
    background: var(--blue);
    color: var(--paper);
    font: 600 12px/1 var(--sans);
    letter-spacing: 0.04em;
    text-align: center;
    text-decoration: none;
    padding: 7px 0;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
    pointer-events: auto;
  }
  .beta-ribbon a:hover,
  .beta-ribbon a:focus-visible {
    background: var(--blue-ink);
  }
  /* Where the page reaches the corner, the header's links keep clear of the ribbon. */
  @media (max-width: 1400px) {
    .bar {
      padding-right: 112px;
    }
  }
  /* The header stays at the top, Subscribe in reach; what else sticks sits below it (--header-h). */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 25;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s5);
    padding-top: var(--s4);
    padding-bottom: var(--s4);
    flex-wrap: wrap;
  }
  .wordmark {
    display: block;
    line-height: 0;
    align-self: center;
  }
  .wordmark img {
    height: 32px;
    width: auto;
  }
  nav {
    display: flex;
    align-items: baseline;
    gap: var(--s5);
    font-size: 15px;
  }
  nav a {
    color: var(--ink-2);
    white-space: nowrap;
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--ink);
  }
  /* The one call to action: the newsletter. */
  nav a.nav-cta {
    color: #fff;
    background: var(--blue);
    border: 1px solid var(--blue);
    border-radius: var(--radius);
    padding: 4px 14px;
  }
  nav a.nav-cta:hover {
    color: #fff;
    background: var(--blue-ink);
    border-color: var(--blue-ink);
  }
  nav a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--blue);
  }
  .site-footer {
    margin-top: var(--s8);
    border-top: 1px solid var(--rule);
    background: var(--paper-2);
  }
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s5);
    font-size: 14px;
  }
  /* Like the header nav: quiet Slate links, Ink on hover, no underline. */
  .foot-links a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .foot-links a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: currentColor;
  }
  .foot-note {
    margin: 0;
    font-size: 13px;
  }
  .foot-note a {
    color: inherit;
  }
  .foot {
    padding-top: var(--s5);
    padding-bottom: var(--s6);
    display: grid;
    gap: var(--s2);
    font-size: 14px;
    color: var(--ink-2);
    max-width: var(--page);
  }
  @media (max-width: 640px) {
    nav {
      gap: var(--s4);
    }
  }
</style>
