---
// The analytics choice: a modal dialog on the first visit that blocks the page until the visitor
// accepts or declines (the native <dialog> makes the rest of the page inert and traps focus). Both
// choices are buttons on this one layer, so declining takes one click, as GDPR consent requires.
// It isn't shown when the browser sends Global Privacy Control or Do Not Track (treated as "Decline"),
// nor on the privacy page itself, which it links to; that page reopens it to change the choice.
// Plain DOM, no island: nothing to hydrate. What each choice means is in src/lib/analytics.ts and on
// the privacy page.

interface Props {
  /** Ask on load if there's no choice yet. Off on the privacy page, so the policy can be read first. */
  ask?: boolean;
}
const { ask = true } = Astro.props;
---

<dialog class="consent" id="consent" aria-labelledby="consent-title" aria-describedby="consent-text" data-ask={ask ? "" : undefined}>
  <h2 id="consent-title">Help us improve charityevals</h2>
  <p id="consent-text">
    We'd like to see which charities people look at and how they get there. Accept, and a random id in this browser
    connects the pages of your visit: no cookies, no names, no ads. Decline, and we count nothing. <a
      href="/privacy#analytics">How it works</a
    >
  </p>
  <p class="consent-state" id="consent-state" aria-live="polite"></p>
  <div class="consent-actions">
    <button type="button" class="consent-accept" data-consent="accept">Accept</button>
    <button type="button" class="consent-decline" data-consent="decline">Decline</button>
  </div>
</dialog>

<script>
  import { getConsent, setConsent, shouldAsk, initAnalytics } from "../lib/analytics";

  const dialog = document.getElementById("consent") as HTMLDialogElement;
  const state = document.getElementById("consent-state")!;
  /** Opened on load without a choice: it stays until one is made. */
  let blocking = false;

  const describe = () => {
    const c = getConsent();
    state.textContent = c === "granted" ? "Your current choice: accepted." : c === "denied" ? "Your current choice: declined." : "";
  };

  const open = (block: boolean) => {
    blocking = block;
    describe();
    if (!dialog.open) dialog.showModal();
    dialog.querySelector<HTMLButtonElement>(".consent-accept")!.focus();
  };

  for (const b of dialog.querySelectorAll<HTMLButtonElement>("[data-consent]"))
    b.addEventListener("click", () => {
      setConsent(b.dataset.consent === "accept");
      blocking = false;
      dialog.close();
    });

  // Escape closes it only when the visitor opened it to change an earlier choice.
  dialog.addEventListener("cancel", (e) => {
    if (blocking) e.preventDefault();
  });
  // Some browsers close a modal on a repeated Escape regardless; without a choice, it comes back.
  dialog.addEventListener("close", () => {
    if (blocking) open(true);
  });

  for (const b of document.querySelectorAll<HTMLElement>("[data-consent-open]")) b.addEventListener("click", () => open(false));

  if (dialog.hasAttribute("data-ask") && shouldAsk()) open(true);

  initAnalytics();
</script>

<style>
  .consent {
    width: min(480px, calc(100% - 32px));
    max-height: calc(100% - 32px);
    margin: auto;
    padding: var(--s6);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.5;
  }
  .consent::backdrop {
    background: rgb(29 36 51 / 0.55);
  }
  /* The page behind can't scroll while the dialog is open. */
  :global(html:has(dialog.consent[open])) {
    overflow: hidden;
  }
  .consent h2 {
    font-size: 24px;
    color: var(--ink);
    margin-bottom: var(--s3);
  }
  .consent-state:empty {
    display: none;
  }
  .consent-state {
    color: var(--ink);
    margin-top: var(--s2);
  }
  .consent-actions {
    display: flex;
    gap: var(--s3);
    margin-top: var(--s5);
  }
  .consent-actions button {
    font: 600 18px/1.2 var(--sans);
    min-height: 52px;
    padding: var(--s3) var(--s5);
    border-radius: var(--radius);
    cursor: pointer;
  }
  /* The one filled button on the site: the choice we ask for. Decline stays a full, visible button. */
  .consent-accept {
    flex: 2;
    background: var(--blue);
    border: 1px solid var(--blue);
    color: #fff;
  }
  .consent-accept:hover {
    background: var(--blue-ink);
    border-color: var(--blue-ink);
  }
  .consent-decline {
    flex: 1;
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    color: var(--ink);
  }
  .consent-decline:hover {
    border-color: var(--ink-3);
    background: var(--paper-2);
  }
  @media (max-width: 640px) {
    .consent {
      padding: var(--s5);
    }
    .consent-actions {
      flex-direction: column;
    }
  }
</style>
