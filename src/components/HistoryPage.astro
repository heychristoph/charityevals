---
// A model's change history, rebuilt from git at build time.
import Base from "../layouts/Base.astro";
import { lib, modelUrl, modelFile } from "../lib/data";
import { modelHistory } from "../lib/history";
import { formatMultiple } from "../lib/format";

interface Props {
  modelId: string;
}
const model = lib.models.get(Astro.props.modelId)!;
const fileOf = (id: string) => modelFile(lib.models.get(id)!);
const files = [...model.chain.map(fileOf), `writeups/${model.id}.md`];
const entries = modelHistory(__REPO_ROOT__, model, files);
const newestFirst = [...entries].reverse();
const repo = "https://github.com/heychristoph/charityevals";

// A small step chart of both bottom lines over the versions, on a log scale.
const pts = entries.filter((e) => e.ours !== undefined);
const vals = pts.flatMap((e) => [e.ours!, e.evaluator ?? e.ours!]);
const [lo, hi] = vals.length ? [Math.min(...vals) / 1.3, Math.max(...vals) * 1.3] : [0.5, 2];
const W = 640, H = 160, P = 8;
const x = (i: number) => (pts.length < 2 ? W / 2 : P + (i * (W - 2 * P)) / (pts.length - 1));
const y = (v: number) => H - P - ((Math.log(v) - Math.log(lo)) / (Math.log(hi) - Math.log(lo))) * (H - 2 * P);
const path = (get: (e: (typeof pts)[number]) => number | undefined) =>
  pts.map((e, i) => { const v = get(e); return v === undefined ? "" : `${i === 0 ? "M" : "L"}${x(i).toFixed(1)},${y(v).toFixed(1)}`; }).join(" ");
---

<Base title={`${model.name}: history`} description={`How the ${model.name} assessment has changed, version by version.`} active="rankings">
  <div class="page wrap" style={`--cause: var(--cause-${model.cause})`}>
    <nav class="crumbs small" aria-label="Breadcrumb"><a href="/">Rankings</a> / <a href={modelUrl(lib, model)}>{model.name}</a> / History</nav>
    <h1>How this assessment has changed</h1>
    <p class="dek">
      Every change to the model, its parent models, the shared assumptions or the shared facts is a commit. For each one we rebuild the site's data as it was then and recompute the result with default assumptions.
    </p>

    {entries.length === 0 ? (
      <p class="empty">No history yet: this model hasn't been committed to the repository.</p>
    ) : (
      <>
        {pts.length > 1 && (
          <figure class="chart">
            <figcaption class="small"><strong>Result per version, × GiveDirectly</strong> <span class="muted">· default assumptions, log scale</span></figcaption>
            <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Result over versions">
              <path d={path((e) => e.evaluator)} class="line-eval" />
              <path d={path((e) => e.ours)} class="line-ours" />
              {pts.map((e, i) => <circle cx={x(i)} cy={y(e.ours!)} r="4" class="dot-ours" />)}
            </svg>
            <p class="small muted legend"><span class="key ours" /> charityevals model <span class="key eval" /> evaluator's model</p>
          </figure>
        )}

        <ol class="versions">
          {newestFirst.map((e) => (
            <li>
              <div class="v-head">
                <div>
                  <strong>{e.subject}</strong>
                  <span class="small muted">
                    {" "}· {e.date}{e.author && ` · ${e.author}`}
                    {e.sha ? <> · <a href={`${repo}/commit/${e.sha}`}><code>{e.sha.slice(0, 7)}</code></a></> : " · not yet committed"}
                  </span>
                </div>
                <div class="v-result num">
                  {e.ours !== undefined ? formatMultiple(e.ours) : "—"}
                  {e.evaluator !== undefined && <span class="small muted"> (evaluator {formatMultiple(e.evaluator)})</span>}
                </div>
              </div>
              {e.note && <p class="small muted">{e.note}</p>}
              {e.changes.length > 0 && (
                <table class="changes small">
                  {e.changes.slice(0, 25).map((c) => (
                    <tr>
                      <th scope="row"><a href={`${modelUrl(lib, model)}#row-${c.id}`}>{c.label}</a></th>
                      <td class="num before">{c.before}</td>
                      <td class="arrow" aria-hidden>→</td>
                      <td class="num">{c.after}</td>
                    </tr>
                  ))}
                  {e.changes.length > 25 && <tr><td colspan="4" class="muted">and {e.changes.length - 25} more rows</td></tr>}
                </table>
              )}
              {e.sha === null && e.changes.length === 0 && !e.note && <p class="small muted">Shared assumptions or facts changed; this model's rows didn't.</p>}
            </li>
          ))}
        </ol>
      </>
    )}
  </div>
</Base>

<style>
  .wrap {
    max-width: 860px;
    padding-top: var(--s5);
  }
  .crumbs {
    color: var(--ink-2);
    margin-bottom: var(--s3);
  }
  h1 {
    margin-bottom: var(--s3);
  }
  .dek {
    color: var(--ink-2);
    font-size: 18px;
    max-width: var(--measure);
    margin-bottom: var(--s6);
  }
  .empty {
    padding: var(--s5);
    background: var(--paper-2);
    border-radius: var(--radius);
  }
  .chart {
    margin: 0 0 var(--s6);
    display: grid;
    gap: var(--s2);
  }
  .chart svg {
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--rule-strong);
  }
  .line-ours {
    fill: none;
    stroke: var(--cause);
    stroke-width: 2;
  }
  .line-eval {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }
  .dot-ours {
    fill: var(--paper);
    stroke: var(--cause);
    stroke-width: 2;
  }
  .legend {
    display: flex;
    gap: var(--s2);
    align-items: center;
  }
  .key {
    display: inline-block;
    width: 18px;
    height: 0;
    border-top: 2px solid var(--cause);
  }
  .key.eval {
    border-top: 1.5px dashed var(--ink-3);
  }
  .versions {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .versions li {
    padding: var(--s4) 0;
    border-bottom: 1px solid var(--rule);
    display: grid;
    gap: var(--s2);
  }
  .v-head {
    display: flex;
    justify-content: space-between;
    gap: var(--s4);
    align-items: baseline;
    flex-wrap: wrap;
  }
  .v-result {
    font: 600 18px/1.2 var(--serif);
    color: var(--cause);
  }
  .changes {
    border-collapse: collapse;
    width: 100%;
  }
  .changes th {
    text-align: left;
    font-weight: 400;
    padding: 3px var(--s3) 3px 0;
  }
  .changes td {
    padding: 3px 0;
    text-align: right;
    word-break: break-word;
  }
  .changes .before {
    color: var(--ink-3);
    text-decoration: line-through;
  }
  .arrow {
    width: 2em;
    text-align: center !important;
    color: var(--ink-3);
  }
</style>
