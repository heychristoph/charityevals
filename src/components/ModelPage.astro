---
// One model's page. /<charity> shows the charity's main model; /<charity>/<model> any other
// (another evaluator's model, or a country variant).
import Base from "../layouts/Base.astro";
import ModelView from "./ModelView.tsx";
import AssumptionsPanel from "./AssumptionsPanel.tsx";
import VariantList from "./VariantList.tsx";
import CharityLogo from "./CharityLogo.tsx";
import SimilarCharities from "./SimilarCharities.tsx";
import Headline from "./Headline.tsx";
import StoryLine from "./StoryLine.tsx";
import WholeCharity, { Locations } from "./WholeCharity.tsx";
import WholeLayers from "./WholeLayers.tsx";
import WholeStoryLine from "./WholeStoryLine.tsx";
import { programsOf } from "../lib/whole";
import ModelReuse from "./ModelReuse.astro";
import { plainModelName } from "../lib/format";
import { lib, rankable, modelUrl, historyUrl, modelFile, primaryOf, summarised } from "../lib/data";
import { similarTo } from "../lib/similar";
import { auditOf, latestRules } from "../lib/audits";
import { repo } from "../lib/site";
import { modelMeta, modelSchema } from "../lib/seo";
import { modelsOf, currentModelsOf } from "../engine/model";
import { locationsOf, rankingPlan } from "../engine/ranking";

interface Props {
  modelId: string;
}
const model = lib.models.get(Astro.props.modelId)!;
const charity = lib.charities.get(model.charity)!;
const owner = lib.owners.get(model.owner)!;
const siblings = modelsOf(lib, charity.id);
// The model selector shows only when the charity has more than one model: a tab per evaluator (their
// current model) and, when there are more, every model, current or older, in a list; for a model with
// country or program variants, the list of those.
const current = currentModelsOf(lib, charity.id);
const file = modelFile(model);
const writeups = import.meta.glob<{ Content: any }>("../../writeups/*.md", { eager: true });
// Variants share their parent's write-up unless they have their own. The charity's main page falls
// back to the write-up filed under its first model: a hand-written evaluation stays on the main page
// when a newer sheet becomes the main model.
const isMain = primaryOf(lib, charity.id)?.id === model.id;
const writeupId = [model.id, ...model.chain.slice(1), ...(isMain ? [siblings[0]?.id] : [])].find((id) => id && writeups[`../../writeups/${id}.md`]);
const Writeup = writeupId ? writeups[`../../writeups/${writeupId}.md`].Content : undefined;
// A write-up's own "Sources" list would sit right above Evidence and sources, so its links join that
// list instead and the section is hidden.
const writeupRaw = import.meta.glob<string>("../../writeups/*.md", { eager: true, query: "?raw", import: "default" });
const sourcesMd = writeupId ? (writeupRaw[`../../writeups/${writeupId}.md`] ?? "").split(/^### Sources\s*$/m)[1]?.split(/^#{2,3} /m)[0] ?? "" : "";
const writeupLinks = [...sourcesMd.matchAll(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g)].map((x) => ({ title: x[1], url: x[2], type: "other" as const }));
const parent = model.extends ? lib.models.get(model.extends) : undefined;
const root = parent && model.kind === "variant" ? parent : model;
const family = [root, ...rankable.filter((m) => m.extends === root.id && m.kind === "variant")];
const RES_GROUPS = [
  ["evaluation", "Evaluations"],
  ["model", "Models and spreadsheets"],
  ["study", "Studies and research"],
  ["data", "Data and documents"],
  ["charity", "From the charity"],
  ["other", "Other sources"],
] as const;
const allResources = [...(charity.resources ?? []), ...(model.resources ?? []), ...writeupLinks].filter((r, i, all) => all.findIndex((x) => x.url === r.url) === i);
const resources = RES_GROUPS.map(([type, title]) => ({ type, title, items: allResources.filter((r) => r.type === type) })).filter((g) => g.items.length);
const CAUSE = { "global-health": "Global health", "animal-welfare": "Animal welfare", "catastrophic-risk": "Catastrophic risk", climate: "Climate" } as const;
// Bulk imports carry a generated summary about the import; the charity's own one-liner reads better.
// One sentence: the charity's own line, else the model summary's first sentence. It doesn't repeat the import boilerplate every model's summary carries
// ("a re-implementation of ...": the method page says it once for all) or the source's title.
const sentences = (s?: string) => s?.trim().split(/(?<=[.!?])\s+(?=[A-Z"'(])/) ?? [];
const BOILERPLATE = /^(A (faithful )?re-implementation of|Every number is traced|Calculated rows reproduce|\w+'s spreadsheet "|The others are listed below)/;
const own = sentences(model.summary).filter((x) => !BOILERPLATE.test(x));
const dek = charity.summary ?? own[0];
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/.*$/, "");
const meta = modelMeta(model);
// Which location the headline is for, when the model is one of several locations: a variant's name
// carries it ("Against Malaria Foundation (Chad)"); the main model's summary names it ("this page
// shows DRC, the median location").
const placeOf = (m: typeof model) =>
  m.kind === "variant"
    ? m.name.startsWith(charity.name) ? m.name.slice(charity.name.length).trim().replace(/^\((.*)\)$/, "$1") : undefined
    : m.summary?.match(/this page shows ([^,.]+(?:\([^)]*\))?), the median/i)?.[1];
// The charity's main page headlines the evaluator's figure as the rankings combine it (Headline).
const main = primaryOf(lib, charity.id)?.id === model.id;
const place = family.length > 1 ? placeOf(model) : undefined;
const placeText = place && (model.kind === "variant" ? `in ${place}` : `in ${place}, the median of ${family.length} locations`);
// The charity's other models and its locations, in one list: both are "other versions of this number".
const others = model.kind !== "variant" && siblings.length > current.length ? siblings : [];
const modelCount = new Set([...others, ...(family.length > 1 ? family : [])].map((m) => m.id)).size;
// A charity whose figure combines several programs shows them as one tree on its main page
// (WholeCharity): the whole charity at the top, each program's model a branch, bulk imports included
// (their file loads when their branch opens; the island waits for the main one's, client:model).
const parts = primaryOf(lib, charity.id)?.id === model.id ? rankingPlan(lib, charity.id).find((e) => e.owner === model.owner)?.parts ?? [] : [];
const whole = parts.length > 1;
// A model with a story (`story`) gets the simple page: the sentence and the likely range first, everything
// else in layers that open one by one (ModelLayers); the evaluator tabs, locations and sources at the end.
// A charity of several programmes gets it too when its programmes split the money (WholeLayers); their
// full files load before the page hydrates (client:model with every summarised programme's id).
const programs = whole && model.story ? programsOf(model) : undefined;
const simple = !!model.story && (!whole || !!programs);
// Every other model of the charity, linked from the simple page's sources so each has a way in.
const elsewhere = simple ? [...new Map([...siblings, ...family].filter((m) => m.id !== model.id && m.output).map((m) => [m.id, m])).values()] : [];
const fetched = programs?.filter((p) => summarised(p.model)).map((p) => p.model.id).join(",") ?? "";
// One programme funded in several locations: its combined figure above the model (WholeCharity: Locations).
const located = parts.length === 1 && locationsOf(lib, parts[0].model).length > 1;
// A few charities doing similar work, to explore from (names only: src/lib/similar.ts).
const similar = similarTo(lib, primaryOf, charity.id).map((id) => {
  const c = lib.charities.get(id)!;
  return { id, name: c.name, summary: c.summary, url: modelUrl(lib, primaryOf(lib, id)!) };
});
const audit = auditOf(model.id);
const fmtDate = (d?: string) => (d ? new Date(d).toLocaleDateString("en-GB", { year: "numeric", month: "long" }) : undefined);
---

<Base title={meta.title} description={meta.description} schema={modelSchema(model, meta.description)} active="rankings">
  <div class:list={["page layout", { simple }]} style={`--cause: var(--cause-${model.cause})`} data-track-charity={charity.id} data-track-model={model.id}>
    <div class="main">
      <nav class="crumbs small" aria-label="Breadcrumb"><a href="/">Rankings</a> / <a href={`/causes/${charity.cause}`}>{CAUSE[charity.cause]}</a>{model.kind === "variant" && <> / <a href={modelUrl(lib, lib.models.get(model.extends!)!)}>{charity.name}</a></>}</nav>
      <header class="m-header">
        <div class="m-title">
          <h1 class="m-name">
            {charity.donate ? (
              <a class="m-name-link" href={charity.donate} rel="noopener" data-track="donate" data-charity={charity.id} title={`Donate to ${charity.name}${charity.donate_via ? ` via ${charity.donate_via}` : ""}`}>
                <CharityLogo id={charity.id} name={charity.name} size={40} lazy={false} className="m-logo" /> {charity.name}
              </a>
            ) : <><CharityLogo id={charity.id} name={charity.name} size={40} lazy={false} className="m-logo" /> {charity.name}</>}
          </h1>
          {summarised(model)
            ? <Headline client:model={model.id} id={model.id} bulk place={placeText} main={main} />
            : <Headline client:load id={model.id} place={placeText} main={main} />}
        </div>
        {simple && current.length > 1 && (
          <nav class="owners owners-top" aria-label="Evaluators' models of this charity">
            {current.map((m) => (
              <a href={modelUrl(lib, m)} aria-current={m.owner === model.owner ? "page" : undefined} class:list={["owner-tab", { here: m.owner === model.owner }]} data-evaluator-tab={m.owner}>
                {lib.owners.get(m.owner)!.name}
              </a>
            ))}
          </nav>
        )}
        {simple ? (
          <p class="dek story-dek">
            {programs
              ? fetched ? <WholeStoryLine client:model={fetched} id={model.id} /> : <WholeStoryLine client:load id={model.id} />
              : summarised(model) ? <StoryLine client:model={model.id} id={model.id} bulk /> : <StoryLine client:load id={model.id} />}
          </p>
        ) : (dek || charity.website) && (
          <p class="dek">
            {dek}
            {charity.website && <> <a class="site-link" href={charity.website} rel="noopener" data-track-kind="charity">{host(charity.website)}</a></>}
          </p>
        )}
      </header>
      {model.theoretical && (
        <aside class="theory-note" role="note" aria-label="Purely theoretical estimate">
          <p>
            <strong>Purely theoretical.</strong> This is {owner.name}'s estimate of the idea, written before {charity.name} existed, not of
            the charity's own results. We show it because {charity.name} runs this programme today
            (<a href={model.theoretical.url} rel="noopener">checked {fmtDate(model.theoretical.checked)}</a>: {model.theoretical.runs.replace(/\.$/, "")})
            and no model of its actual work exists yet.
          </p>
        </aside>
      )}
{!simple && (
      <div class="m-model">
        {current.length > 1 && (
          <nav class="owners" aria-label="Evaluators' models of this charity">
            {current.map((m) => {
              const here = m.owner === model.owner;
              return (
                <a href={modelUrl(lib, m)} aria-current={here ? "page" : undefined} class:list={["owner-tab", { here }]} data-evaluator-tab={m.owner}>
                  {lib.owners.get(m.owner)!.name}{m.theoretical && <span class="owner-tab-note"> (purely theoretical)</span>}
                </a>
              );
            })}
          </nav>
        )}
        {modelCount > 1 && !(whole && others.every((m) => parts.some((p) => p.model.id === m.id))) && (
          <details class="m-disclosure small" open={modelCount <= 8}>
            <summary>{model.kind === "variant" ? `${family.length} locations in ${owner.name}'s model` : `All ${modelCount} models of ${charity.name}`}</summary>
            {family.length > 1 && (
              <div class="m-list">
                {others.length > 0 && <h3 class="m-list-title">Locations in {owner.name}'s model</h3>}
                <VariantList client:load ids={family.map((m) => m.id)} current={model.id} names={Object.fromEntries(family.flatMap((m) => { const p = placeOf(m); return p ? [[m.id, p]] : []; }))} />
              </div>
            )}
            {others.length > 0 && (
              <div class="m-list">
                {family.length > 1 && <h3 class="m-list-title">Every evaluator's models, newest first</h3>}
                <VariantList client:load ids={others.map((m) => m.id)} current={model.id} dated />
              </div>
            )}
          </details>
        )}
      </div>
      )}
      {/* A model the browser has only as a summary (lib/browser-models.ts) hydrates once its full file has
          loaded (client:model), rather than carrying it as a prop. */}
      {whole ? (
        <>
        {programs ? (
          fetched ? (
            <WholeLayers client:model={fetched} id={model.id}>
              <section class="writeup">
                {Writeup && <div class="writeup-body" data-gloss><Writeup /></div>}
                <div class="wf-slot" data-waterfall={model.id}><div class="wf-skeleton" aria-hidden="true"><span class="sk-title"></span><span></span><span></span><span></span><span></span></div></div>
              </section>
            </WholeLayers>
          ) : (
            <WholeLayers client:load id={model.id}>
              <section class="writeup">
                {Writeup && <div class="writeup-body" data-gloss><Writeup /></div>}
                <div class="wf-slot" data-waterfall={model.id}><div class="wf-skeleton" aria-hidden="true"><span class="sk-title"></span><span></span><span></span><span></span><span></span></div></div>
              </section>
            </WholeLayers>
          )
        ) : summarised(model) ? (
          <WholeCharity client:model={model.id} id={model.id}>
          <section class="writeup" aria-labelledby={simple ? undefined : "writeup-title"}>
            {!simple && <h2 id="writeup-title" class="writeup-title">The evaluation</h2>}
            {Writeup && <div class="writeup-body" data-gloss><Writeup /></div>}
            {/* From the evaluator's figure to the one shown: filled by the model's island (Waterfall). */}
            <div class="wf-slot" data-waterfall={model.id}><div class="wf-skeleton" aria-hidden="true"><span class="sk-title"></span><span></span><span></span><span></span><span></span></div></div>
          </section>
        </WholeCharity>
        ) : (
          <WholeCharity client:model={model.id} id={model.id}>
          <section class="writeup" aria-labelledby={simple ? undefined : "writeup-title"}>
            {!simple && <h2 id="writeup-title" class="writeup-title">The evaluation</h2>}
            {Writeup && <div class="writeup-body" data-gloss><Writeup /></div>}
            {/* From the evaluator's figure to the one shown: filled by the model's island (Waterfall). */}
            <div class="wf-slot" data-waterfall={model.id}><div class="wf-skeleton" aria-hidden="true"><span class="sk-title"></span><span></span><span></span><span></span><span></span></div></div>
          </section>
        </WholeCharity>
        )}
        {!programs && <p class="m-links small">
          <a href={`${repo}/blob/main/${file}`} data-track-kind="model-file">Model file</a> · <a href={historyUrl(model)} data-track-kind="history">History</a>
              {audit && <> · <a href={`${repo}/blob/main/${audit.path}`} data-track-kind="audit">Audit</a>{audit.rules && <>, <a href="/changelog">rules {audit.rules}</a>{audit.behind && <span class="muted"> (latest {latestRules})</span>}</>}</>}
          <ModelReuse model={model}>{owner.permission && <span class="muted"> · {owner.permission}</span>}</ModelReuse>
        </p>}
        </>
      ) : summarised(model) ? (
        <>
        {located && !simple && <Locations client:load id={model.id} />}
        <ModelView client:model={model.id} id={model.id} bulk place={place}>
          <Fragment slot="about">
            <p>
              {model.source ? <a href={model.source.url} data-track-kind="source">{plainModelName(model.name)}</a> : <strong>{plainModelName(model.name)}</strong>}
              {" "}by <a href={`/evaluators/${owner.id}`}>{owner.name}</a>{model.source?.published && <>, {fmtDate(model.source.published)}</>}.{owner.id === "charityevals" ? <> Built and checked by AI agents, by our <a href="/method#our-models">published method</a>.</> : <> Converted to our scale by AI agents, by our <a href="/method">published method</a>.</>}
              {parent && <> It extends <a href={modelUrl(lib, parent)}>{plainModelName(parent.name)}</a>, inheriting every row and overriding a few.</>}
            </p>
            <p class="m-links">
              {model.source?.sheet && <><a href={model.source.sheet} data-track-kind="spreadsheet">Spreadsheet</a> · </>}
              <a href={`${repo}/blob/main/${file}`} data-track-kind="model-file">Model file</a> · <a href={historyUrl(model)} data-track-kind="history">History</a>
              {audit && <> · <a href={`${repo}/blob/main/${audit.path}`} data-track-kind="audit">Audit</a>{audit.rules && <>, <a href="/changelog">rules {audit.rules}</a>{audit.behind && <span class="muted"> (latest {latestRules})</span>}</>}</>}
              <ModelReuse model={model}>{owner.permission && <span class="muted"> · {owner.permission}</span>}</ModelReuse>
            </p>
          </Fragment>
          <section class="writeup" aria-labelledby={simple ? undefined : "writeup-title"}>
            {!simple && <h2 id="writeup-title" class="writeup-title">The evaluation</h2>}
            {Writeup && <div class="writeup-body" data-gloss><Writeup /></div>}
            {/* From the evaluator's figure to the one shown: filled by the model's island (Waterfall). */}
            <div class="wf-slot" data-waterfall={model.id}><div class="wf-skeleton" aria-hidden="true"><span class="sk-title"></span><span></span><span></span><span></span><span></span></div></div>
          </section>
        </ModelView>
        </>
      ) : (
        <>
        {located && !simple && <Locations client:load id={model.id} />}
        <ModelView client:model={model.id} id={model.id} place={place}>
          <Fragment slot="about">
            <p>
              {model.source ? <a href={model.source.url} data-track-kind="source">{plainModelName(model.name)}</a> : <strong>{plainModelName(model.name)}</strong>}
              {" "}by <a href={`/evaluators/${owner.id}`}>{owner.name}</a>{model.source?.published && <>, {fmtDate(model.source.published)}</>}.{owner.id === "charityevals" ? <> Built and checked by AI agents, by our <a href="/method#our-models">published method</a>.</> : <> Converted to our scale by AI agents, by our <a href="/method">published method</a>.</>}
              {parent && <> It extends <a href={modelUrl(lib, parent)}>{plainModelName(parent.name)}</a>, inheriting every row and overriding a few.</>}
            </p>
            <p class="m-links">
              {model.source?.sheet && <><a href={model.source.sheet} data-track-kind="spreadsheet">Spreadsheet</a> · </>}
              <a href={`${repo}/blob/main/${file}`} data-track-kind="model-file">Model file</a> · <a href={historyUrl(model)} data-track-kind="history">History</a>
              {audit && <> · <a href={`${repo}/blob/main/${audit.path}`} data-track-kind="audit">Audit</a>{audit.rules && <>, <a href="/changelog">rules {audit.rules}</a>{audit.behind && <span class="muted"> (latest {latestRules})</span>}</>}</>}
              <ModelReuse model={model}>{owner.permission && <span class="muted"> · {owner.permission}</span>}</ModelReuse>
            </p>
          </Fragment>
          <section class="writeup" aria-labelledby={simple ? undefined : "writeup-title"}>
            {!simple && <h2 id="writeup-title" class="writeup-title">The evaluation</h2>}
            {Writeup && <div class="writeup-body" data-gloss><Writeup /></div>}
            {/* From the evaluator's figure to the one shown: filled by the model's island (Waterfall). */}
            <div class="wf-slot" data-waterfall={model.id}><div class="wf-skeleton" aria-hidden="true"><span class="sk-title"></span><span></span><span></span><span></span><span></span></div></div>
          </section>
        </ModelView>
        </>
      )}
      {resources.length > 0 && (
        <details class:list={["resources", { "ly-layer": simple }]}>
          <summary>{simple && <Fragment set:html={'<svg class="ly-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>'} />}<h2 id="resources-title">Evidence and sources{!simple && <> <span class="muted num">{allResources.length}</span></>}</h2></summary>
          {!simple && <p class="muted small">Everything the evaluation links to, to check it yourself.</p>}
          {simple && (
            <div class="tn-about small sources-about">
              <p>
                {model.source ? <a href={model.source.url} data-track-kind="source">{plainModelName(model.name)}</a> : <strong>{plainModelName(model.name)}</strong>}
                {" "}by <a href={`/evaluators/${owner.id}`}>{owner.name}</a>{model.source?.published && <>, {fmtDate(model.source.published)}</>}.{owner.id === "charityevals" ? <> Built and checked by AI agents, by our <a href="/method#our-models">published method</a>.</> : <> Converted to our scale by AI agents, by our <a href="/method">published method</a>.</>}
                {parent && <> It extends <a href={modelUrl(lib, parent)}>{plainModelName(parent.name)}</a>, inheriting every row and overriding a few.</>}
              </p>
              <p class="m-links">
                {model.source?.sheet && <><a href={model.source.sheet} data-track-kind="spreadsheet">Spreadsheet</a> · </>}
                <a href={`${repo}/blob/main/${file}`} data-track-kind="model-file">Model file</a> · <a href={historyUrl(model)} data-track-kind="history">History</a>
                {audit && <> · <a href={`${repo}/blob/main/${audit.path}`} data-track-kind="audit">Audit</a>{audit.rules && <>, <a href="/changelog">rules {audit.rules}</a>{audit.behind && <span class="muted"> (latest {latestRules})</span>}</>}</>}
                <ModelReuse model={model}>{owner.permission && <span class="muted"> · {owner.permission}</span>}</ModelReuse>
              </p>
              {elsewhere.length > 0 && (
                <p class="m-links">
                  Other models: {elsewhere.map((m, i) => <>{i > 0 && " · "}<a href={modelUrl(lib, m)}>{plainModelName(m.name)}</a> ({lib.owners.get(m.owner)?.short ?? m.owner})</>)}
                </p>
              )}
            </div>
          )}
          {resources.map((g) => (
            <div class="res-group">
              <h3>{g.title} <span class="muted small num">{g.items.length}</span></h3>
              <ul>
                {g.items.slice(0, 8).map((r) => <li><a href={r.url} rel="noopener" data-track-kind={`resource-${g.type}`}>{r.title}</a>{r.note && <span class="muted small"> · {r.note}</span>}</li>)}
              </ul>
              {g.items.length > 8 && (
                <details>
                  <summary class="small">Show {g.items.length - 8} more</summary>
                  <ul>{g.items.slice(8).map((r) => <li><a href={r.url} rel="noopener" data-track-kind={`resource-${g.type}`}>{r.title}</a></li>)}</ul>
                </details>
              )}
            </div>
          ))}
        </details>
      )}
      {similar.length > 0 && (
        <nav class="similar" aria-labelledby="similar-title">
          <h2 id="similar-title">Similar charities</h2>
          <SimilarCharities client:visible items={similar} />
        </nav>
      )}
    </div>
    <aside class="side" aria-label="Assumptions">
      <AssumptionsPanel client:load />
    </aside>
  </div>
</Base>

<script>
  import { track } from "../lib/analytics";

  // The model selector's tabs are plain links; count which evaluator visitors switch to.
  for (const tab of document.querySelectorAll<HTMLAnchorElement>("[data-evaluator-tab]"))
    tab.addEventListener("click", () => track("evaluator_tab", { key: tab.dataset.evaluatorTab, detail: tab.hasAttribute("aria-current") ? "page" : "other" }));
</script>

<style>
  .writeup-body :global(h3#sources),
  .writeup-body :global(h3#sources ~ *) {
    display: none;
  }
  .theory-note {
    margin: 0 0 1rem;
    padding: 0.6rem 0.8rem;
    border-left: 3px dashed var(--cause);
    background: color-mix(in srgb, var(--cause) 7%, transparent);
  }
  .theory-note p {
    margin: 0;
  }
  .owner-tab-note {
    font-weight: 400;
    font-style: italic;
  }
  .resources summary {
    cursor: pointer;
    color: var(--ink);
  }
  .resources summary h2 {
    display: inline;
  }
  /* The simple page (a model with a story): one column of layers; tabs, locations and sources move to the end. */
  .dek.story-dek {
